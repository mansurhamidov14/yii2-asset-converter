{
    "name": "twelver313/yii2-asset-converter",
    "description": "Less, Sass, Scss and Phamlp converter for Yii2. No system requires. yii2-composer support, Less autoupdate, customizing of output directory",
    "type": "yii2-extension",
    "keywords": ["yii", "yii2", "asset", "converter", "less", "sass", "scss", "compass", "phamlp"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Alex Sharov",
            "email": "www.pismeco@gmail.com",
            "role": "Author"
        },
        {
            "name": "Mansur Hamidov",
            "email": "mansur.hamidov.19@gmail.com",
            "role": "Developer"
        }
    ],
    "require" : {
        "php": ">=5.4.0",
        "yiisoft/yii2": "2.*",
        "yiisoft/yii2-composer": "2.*",
        "wikimedia/less.php": "3.0.0.*",
        "richthegeek/phpsass": "1.*",
        "scssphp/scssphp": "1.*",
        "yourilima/scssphp-compass": "1.*"
    },
    "autoload": {
        "psr-0": { "Twelver313\\AssetConverter\\": "" }
    },
    "target-dir": "Twelver313/AssetConverter",
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
